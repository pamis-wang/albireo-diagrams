    },
    {
      "id": "ph_place",
      "label": "輪流挑",
      "fromCol": 4,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "ph_out",
      "label": "輸出",
      "fromCol": 5,
      "toCol": 5
    }
  ],
