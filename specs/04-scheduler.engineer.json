      "to": "round",
      "variant": "emphasis"
    },
    {
      "from": "round",
      "to": "result",
      "label": "每層做完",
      "variant": "emphasis"
    },
    {
      "from": "result",
      "to": "save",
      "variant": "emphasis"
    },
    {
      "from": "pairs",
      "to": "ai_score"
    },
    {
      "from": "ai_score",
      "to": "ai_tier"
    },
    {
      "from": "ai_tier",
