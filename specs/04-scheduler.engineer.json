    },
    {
      "from": "ai_score",
      "to": "ai_fail",
      "label": "失敗或逾時",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "兩個引擎只差在排序（D25）",
      "items": [
        "原排程引擎：互選 → 單向 → 補位，層內志願序小的先，同分用種子隨機（D12、D13）",
        "AI 配對引擎：總分＝速配度＋0.3／甲組名次＋0.3／乙組名次，補位排最後（D26）",
        "單向優先只影響原排程引擎；補位設定兩者都遵守（D27）"
      ]
    },
    {
      "dot": "emerald",
      "title": "輪流挑與硬限制",
      "items": [
        "每輪每個單位挑一組：場次少的先，再看最好組合在整層的位置",
        "放進雙方共同最早的空時段，排不進就標記不再看",
        "同時段一人一場、同組合全場一次、每人最多場次"
      ]
    },
    {
      "dot": "amber",
      "title": "執行模式與輸出",
      "items": [
        "產生／全部重排（保留鎖定與手動，D23）／只補空時段（發布後可補約）",
        "同輸入同種子必得同結果，種子存進時程表",
        "沒排到原因：自己排滿 → 對方排滿 → 時段對不上"
      ]
    }
  ]
