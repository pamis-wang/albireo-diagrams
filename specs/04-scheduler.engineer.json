      "id": "ai_score",
      "lane": "ai",
      "col": 2,
      "width": 140,
      "type": "cloud",
      "label": "AI 速配度",
      "sublabel": "雙向各算，取較低者"
    },
    {
      "id": "ai_tier",
      "lane": "ai",
      "col": 3,
      "width": 140,
      "type": "backend",
      "label": "依總分排序",
      "sublabel": "速配度＋志願加分"
    }
  ],
  "edges": [
    {
      "from": "gate",
      "to": "inputs",
      "variant": "emphasis"
    },
    {
      "from": "inputs",
      "to": "pairs",
      "variant": "emphasis"
    },
    {
      "from": "pairs",
      "to": "std_tier",
      "label": "standard",
      "variant": "emphasis"
    },
