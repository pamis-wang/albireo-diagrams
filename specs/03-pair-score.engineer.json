        "id": "privacy",
        "label": "隱私邊界",
        "focus": [
          "application",
          "schema",
          "counterpartView"
        ],
        "note": "交給 AI 的上限就是對方看得到的內容：MatchingCounterpartView 先剝掉，不靠 API 層記得。"
      },
      {
        "id": "dimensions",
        "label": "逐面向計分",
        "focus": [
          "business",
          "market",
          "wants",
          "decision",
          "combine"
        ],
        "note": "每一題是一個面向，依權重加權平均；只有業務項目會呼叫外部服務。"
      },
      {
        "id": "consumers",
        "label": "三個用途",
        "focus": [
          "combine",
          "mateList",
          "aiEngine",
          "reason"
        ],
        "note": "互選候選清單、AI 配對引擎與推薦理由共用同一套面向事實。"
      }
    ]
  },
