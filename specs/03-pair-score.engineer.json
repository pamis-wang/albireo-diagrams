      "via": [
        [
          315,
          157
        ]
      ]
    },
    {
      "id": "view-market",
      "from": "counterpartView",
      "to": "market",
      "label": "市場自述與期望",
      "variant": "security"
    },
    {
      "id": "view-wants",
      "from": "counterpartView",
      "to": "wants",
      "label": "開放期望的題目",
      "variant": "security",
      "fromSide": "bottom",
      "via": [
        [
          315,
          385
        ]
      ]
    },
    {
      "id": "business-decision",
      "from": "business",
      "to": "decision",
      "label": "未命中才問",
      "variant": "dashed"
    },
    {
      "id": "decision-combine",
      "from": "decision",
      "to": "combine",
      "label": "互補級別 0–1",
      "variant": "default",
      "labelAt": [
        745,
        214
      ]
    },
    {
      "id": "market-combine",
      "from": "market",
      "to": "combine",
      "label": "0–1；沒填 0.5",
      "variant": "emphasis"
    },
    {
      "id": "wants-combine",
      "from": "wants",
      "to": "combine",
      "label": "0 或 1；沒填 0.5",
      "variant": "default",
      "toSide": "bottom",
      "via": [
        [
          745,
          385
        ]
      ]
    },
    {
      "id": "combine-mates",
      "from": "combine",
      "to": "mateList",
      "label": "查看者→對方",
      "variant": "emphasis"
    },
    {
      "id": "combine-engine",
      "from": "combine",
      "to": "aiEngine",
      "label": "雙向",
      "variant": "emphasis",
      "labelAt": [
        878,
        271
      ]
    },
    {
      "id": "combine-reason",
      "from": "combine",
      "to": "reason",
      "label": "同一套面向事實",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "計分規則",
      "items": [
        "業務項目：命中期望直接 1；未命中問 favored_fit（最高 0.75）；沒填期望問 fit 業態互補（0–1）",
        "經營市場：有期望看任一命中，沒期望比重疊係數（重疊數 ÷ 較少的一方）",
        "對方沒填給 0.5；查看者自己沒得比的面向不計入；全部不計時為 null"
      ]
    },
    {
      "dot": "amber",
      "title": "快取與失敗",
      "items": [
        "鍵 matching-pair-score:{活動}:business-fit:{請求 SHA-256}，模型代號在鍵裡",
        "決策模型並行上限 8；候選清單逾時 5 秒、AI 配對引擎 60 秒",
        "任一組失敗整批不可用：候選清單照回、前端改條件比對；AI 配對引擎回錯不退回隨機（D28）"
      ]
    },
    {
      "dot": "rose",
      "title": "隱私邊界",
      "items": [
        "只留 IsVisibleToCounterpart 的自述；期望另看 IsFavoredVisibleToCounterpart",
        "聯絡方式、報名編號、桌號、審核資訊、出席者姓名職稱都不送 AI",
        "原排程引擎不接速配度；MCP 主機不給 AI Provider 金鑰"
      ]
    }
  ]
}
