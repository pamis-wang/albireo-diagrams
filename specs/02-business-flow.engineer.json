  "cards": [
    {
      "dot": "cyan",
      "title": "活動六階段",
      "items": [
        "MatchingPhaseResolver 依伺服器 UTC 時間算出，不存資料庫",
        "未開放報名→報名中→報名結束→互選中→互選結束→結果已公布",
        "報名只在報名中；互選只在互選中，且限已核可報名"
      ]
    },
    {
      "dot": "rose",
      "title": "鎖定與閘門",
      "items": [
        "時程表建立後鎖住互選與時段，捨棄草稿才解鎖",
        "已發布不能捨棄或全部重排，可只補空時段",
        "參展單位看時程表：Published 且到 MateResultAt"
      ]
    },
    {
      "dot": "amber",
      "title": "排程與入駐規則",
      "items": [
        "全部重排保留鎖定與手動會談；兩引擎可同種子比較",
        "參展單位登入：帳號已開通且單位 Approved",
        "報名改判非核可：同一交易清掉互選與會談"
      ]
    }
  ]
