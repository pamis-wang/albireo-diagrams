    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "security": {
          "label": "營運操作"
        },
        "backend": {
          "label": "主辦單位操作"
        },
        "frontend": {
          "label": "參展單位操作"
        },
        "external": {
          "label": "AI 服務（OpenRouter）"
        }
      }
    },
    "views": [
      {
        "id": "onboarding",
        "label": "開通與入駐",
        "focus": [
          "op_onboard",
          "org_rbac",
          "ex_register",
          "org_review_exh",
          "ex_invite"
        ],
        "note": "OrganizerAdministratorService 建管理者寄邀請信；ExhibitorReviewService 決定參展單位能否登入。"
      },
      {
        "id": "setup_apply",
        "label": "活動設定與報名",
        "focus": [
          "org_rbac",
          "org_create",
          "ex_invite",
          "ex_apply",
          "org_review_app"
        ],
        "note": "報名只在 Applying 階段；核可時 AssignCodeAsync 依活動格式配發報名編號。"
      },
      {
        "id": "mating",
        "label": "互選與 AI",
        "focus": [
          "org_review_app",
          "ex_mate",
          "ai_score"
        ],
        "note": "MatchingMateService 只開放已核可報名，在 Mating 階段整批取代志願序。"
      },
      {
        "id": "scheduling",
        "label": "排程與公布",
        "focus": [
          "org_review_app",
          "ex_mate",
          "org_schedule",
          "ex_view"
        ],
        "note": "時程表一建立就鎖住互選與時段；Published 且 ResultPublished 才給參展單位看。"
      }
    ]
  },
