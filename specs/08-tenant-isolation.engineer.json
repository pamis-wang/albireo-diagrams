{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Albireo 多租戶隔離",
    "output": "engineer/08-tenant-isolation.html",
    "locale": "zh-TW",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1280,
      772
    ],
    "views": [
      {
        "id": "before-login",
        "label": "登入前：路由代碼",
        "focus": [
          "web",
          "api",
          "scope"
        ],
        "note": "登入、註冊、重設密碼以路由的 {organizerCode} 決定主辦單位，不存在回 404、停用回 403。"
      },
      {
        "id": "authorized-query",
        "label": "登入後查詢",
        "focus": [
          "api",
          "jwt",
          "scope",
          "authz",
          "redis",
          "ctx",
          "pg"
        ],
        "note": "權杖的 organizer_id 決定範圍，主辦端再查資源權限，最後由全域篩選只取本主辦單位的資料。"
      },
      {
        "id": "write-stamp",
        "label": "寫入",
        "focus": [
          "api",
          "ctx"
        ],
        "note": "SaveChanges 自動填 organizer_id；沒有範圍或寫到別家直接丟例外。"
      },
      {
        "id": "operator-bypass",
        "label": "營運端與明確略過",
        "focus": [
          "web",
          "api",
          "scope",
          "ctx"
        ],
        "note": "營運端以路由 {organizerId} 代入主辦單位；只有少數方法明確略過篩選。"
      }
    ]
  },
